{
  "name": "announcement-api",
  "version": "0.4.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "module": "ts-node cli/index.ts",
    "start:dev": "nest start --watch --tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "dev": "dotenv -e .env.dev -- docker compose -f docker-compose.dev.yml up --build",
    "db:generate": "dotenv -e .env.dev -- docker compose -f docker-compose.dev.yml exec app npx prisma generate",
    "db:migrate": "dotenv -e .env.dev -- docker compose -f docker-compose.dev.yml exec app npx prisma migrate dev",
    "generate:token": "node --experimental-strip-types ./src/shared/middleware/auth/mockData/generateToken.ts",
    "db:seed": "dotenv -e .env.dev -- docker compose -f docker-compose.dev.yml exec app yarn ts-node ./src/shared/database/seed/seed.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:unit": "dotenv -e .env.dev -- jest --testRegex=\".*\\.spec\\.ts$\" --watch --verbose",
    "test:watch": "dotenv -e .env.dev -- jest --runInBand --testRegex=\".*\\.e2e-spec.ts$\"",
    "test:cov": "dotenv -e .env.dev -- jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^5.10.2",
    "axios": "^1.10.0",
    "axios-retry": "^4.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "dotenv-cli": "^8.0.0",
    "ioredis": "^5.6.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "commander": "^12.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^5.10.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}